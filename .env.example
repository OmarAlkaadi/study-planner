# Vorlage für die Umgebungsvariablen.

# ---------- Datenbank ----------
DB_USER=studyplanner
# Achtung: PostgreSQL übernimmt das Passwort nur beim allerersten Start (leeres Daten-Volume).
# Später ändern: erst in der Datenbank (ALTER USER ... PASSWORD ...), dann hier.
DB_PASSWORD=studyplanner

# ---------- Login ----------
# Schlüssel zum Signieren der Login-Tokens (mindestens 32 Zeichen), z. B. erzeugt mit:
#   openssl rand -base64 48
# Leer lassen = zufälliger Schlüssel bei jedem Start (für lokales Ausprobieren völlig ausreichend).
JWT_SECRET=
# Lebensdauer des Access-Tokens in Minuten (bewusst kurz – es wird automatisch erneuert)
JWT_EXPIRATION_MINUTES=15
# So viele Tage bleibt man angemeldet, ohne das Passwort erneut einzugeben (Refresh-Token)
REFRESH_TOKEN_DAYS=30
# Refresh-Cookie nur über HTTPS senden: lokal false, auf einem Server mit HTTPS unbedingt true
AUTH_COOKIE_SECURE=false

# Demo-Account (demo@studyplanner.de / demo1234) mit Beispieldaten anlegen
APP_DEMO_DATA=true

# Adresse, unter der das Frontend erreichbar ist – daraus entstehen die Links in den E-Mails
APP_FRONTEND_URL=http://localhost:3000


